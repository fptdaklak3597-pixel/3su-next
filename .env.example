# Local only — copy to .env.local. Không commit .env.local.
# Project Firebase mới: su-next (tách khỏi production su-eshop / 3su.shop).

VITE_API_BASE=http://127.0.0.1:8787

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=1:YOUR_SENDER_ID:web:YOUR_APP_ID
VITE_GOOGLE_WEB_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Chỉ bật khi chủ đích chạy authoritative money/stock (dev/staging). Production mặc định tắt.
# VITE_ALLOW_AUTHORITATIVE=1
