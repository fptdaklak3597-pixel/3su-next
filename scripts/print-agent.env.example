# Copy values into your process/service environment. Do not commit real secrets.

PORT=9101

# Localhost-only mode (default):
PRINT_AGENT_HOST=127.0.0.1

# LAN mode: set 1 and use a random secret of at least 16 characters.
# PRINT_AGENT_LAN=1
# PRINT_AGENT_SECRET=replace-with-a-long-random-secret

# Optional hardening/tuning:
# PRINT_AGENT_ORIGINS=https://your-pos.example
# PRINT_QUEUE_LIMIT=20
# PRINT_RATE_LIMIT=30
# PRINT_HANDOFF_MS=1500
# CHROME_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe

# Optional cloud queue polling:
# PRINT_API=https://your-worker.example
# PRINT_SHOP=shop_xxx
# PRINT_TOKEN_FILE=C:\\ProgramData\\3su\\print-token.txt
# PRINT_AGENT_ID=front-counter-printer

# Legacy compatibility only; prefer PRINT_TOKEN_FILE.
# PRINT_TOKEN=
